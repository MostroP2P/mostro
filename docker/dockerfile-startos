# Toolchain stage, shared by the planner and the builder
FROM rust:1.94-alpine AS chef

# Install build dependencies
RUN apk update && \
    apk add --no-cache cmake build-base sqlite-dev pkgconfig protoc perl git

# Set working directory
WORKDIR /mostro

# The toolchain the project pins is installed here, once, so the dependencies
# and Mostro are compiled by the same rustc: a different one in the final build
# would recompile every dependency
COPY rust-toolchain.toml ./
RUN rustup toolchain install

RUN cargo install cargo-chef --version 0.1.78 --locked

# Planner stage: reduce the manifests to a recipe that only changes when the
# dependencies do
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# Build stage
FROM chef AS builder

# Compile the dependencies in their own layer, so a release that only changes
# Mostro's sources reuses them from the cache
COPY --from=planner /mostro/recipe.json recipe.json
RUN cargo chef cook --release --features startos --recipe-path recipe.json

# Copy source code
COPY . .

# Build the project in release mode
RUN cargo build --release --features startos

# Production stage
FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache ca-certificates sqlite-libs && \
    apk add --no-cache --repository http://dl-cdn.alpinelinux.org/alpine/edge/testing grpcurl

# Create the mostro data directory
RUN mkdir -p /mostro

# Set working directory to /mostro for persistent data
WORKDIR /mostro
# Copy proto files from build stage for grpcurl health checks
COPY --from=builder /mostro/proto /proto

# Copy built binary from build stage
COPY --from=builder /mostro/target/release/mostrod /usr/local/bin/mostrod
